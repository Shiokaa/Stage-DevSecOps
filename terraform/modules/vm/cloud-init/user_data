#cloud-config

hostname: ${hostname}
fqdn: ${hostname}.${domain}
manage_etc_hosts: true

users:
  - name: ${ci_user}
    groups: [sudo, adm]
    shell: /bin/bash
    sudo: ALL=(ALL) NOPASSWD:ALL
    lock_passwd: true
    ssh_authorized_keys:
      - ${ci_ssh_keys}

ssh_pwauth: false

manage_resolv_conf: true
resolv_conf:
  nameservers: ['192.168.10.249', '8.8.4.4', '8.8.8.8']
  searchdomains:
    - tom.lan
  options:
    rotate: true
    timeout: 3

timezone: Europe/Paris