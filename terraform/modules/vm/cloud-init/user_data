#cloud-config

hostname: ${hostname}
fqdn: ${hostname}.${domain}
manage_etc_hosts: true

users:
  - name: ${ci_user}
    groups: [sudo, adm]
    shell: /bin/bash
    sudo: ALL=(ALL) NOPASSWD:ALL
    lock_passwd: true
    ssh_authorized_keys:
      - ${ci_ssh_keys}

ssh_pwauth: false

timezone: Europe/Paris

growpart:
  mode: auto
  devices: ['/']
  ignore_headroom: false

runcmd:
  - growpart /dev/sda 3
  - pvresize /dev/sda3
  - lvextend -l +100%FREE /dev/ubuntu-vg/ubuntu-lv
  - resize2fs /dev/ubuntu-vg/ubuntu-lv