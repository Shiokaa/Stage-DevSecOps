            "overwrite": true,
            "source_file": [],
            "source_raw": [
              {
                "data": "#cloud-config\n\n# ---------------------------------------------------------------------------\n# 1. Identité (Indispensable pour éviter les conflits réseau entre les clones)\n# ---------------------------------------------------------------------------\nhostname: tom-test\nfqdn: tom-test.tom-local\nmanage_etc_hosts: true\n\n# ---------------------------------------------------------------------------\n# 2. Accès et Sécurité (Pour injecter les clés SSH de l'utilisateur final)\n# ---------------------------------------------------------------------------\nusers:\n  - name: sysadmin\n    sudo: ALL=(ALL) NOPASSWD:ALL\n    shell: /bin/bash\n    lock_passwd: true\n    ssh_authorized_keys:\n      - ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIIYyQDz/e+EgznXRjxP0UgonYLI3GTgUb73RAfw9gSOW shioka@Shioka-pc\n\n\nssh_pwauth: false\ndisable_root: true\n\n# ---------------------------------------------------------------------------\n# 3. Gestion du disque (TRÈS IMPORTANT !)\n# ---------------------------------------------------------------------------\n# Si Terraform demande un disque plus grand que la template Packer d'origine,\n# ceci force la partition racine à s'étendre pour utiliser tout le nouvel espace.\ngrowpart:\n  mode: auto\n  devices: [\"/\"]\n\n# ---------------------------------------------------------------------------\n# 4. (Optionnel) Scripts spécifiques à cette instance\n# ---------------------------------------------------------------------------\n# runcmd:\n#  - echo \"Cette machine tom-test vient de naître d'une template Packer !\" \u003e /tmp/info.txt\n",
                "file_name": "tom-test.tom-local-ci-user.yml",
                "resize": 0
              }
            ],
            "timeout_upload": 1800
          },
          "sensitive_attributes": [],
          "identity_schema_version": 0,
          "private": "bnVsbA=="
        }
